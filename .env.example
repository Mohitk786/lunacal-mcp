# Postgres connection string for the MCP server's own database.
# Inside docker compose this is overridden to postgres://mcp:...@postgres:5432/lunacal_mcp
DATABASE_URL=postgres://mcp:change-me@127.0.0.1:5432/lunacal_mcp

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Losing this key makes stored Lunacal tokens unreadable. Users must reconnect.
MCP_TOKEN_ENC_KEY=

# Lunacal webapp origin. No trailing slash required.
LUNACAL_WEBAPP_URL=https://app.lunacal.ai

# Platform OAuth client provisioned in Lunacal. The secret is sent only to Lunacal.
LUNACAL_OAUTH_CLIENT_ID=
LUNACAL_OAUTH_CLIENT_SECRET=

# Public origin MCP clients use. Must match the URL they connect to.
LUNACAL_MCP_PUBLIC_URL=http://localhost:3939

PORT=3939

# Set true only behind a trusted reverse proxy. Otherwise X-Forwarded-For is ignored.
TRUST_PROXY=false

# Password for the compose Postgres role `mcp`. Use letters and digits so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Optional. OpenAI domain verification token served at /.well-known/openai-apps-challenge
OPENAI_DOMAIN_TOKEN=

# Optional rate limits (requests per 60 seconds).
# MCP_RATE_LIMIT_MAX=300
# OAUTH_RATE_LIMIT_MAX=300
# REGISTER_RATE_LIMIT_MAX=60
